{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_CIPHERCHAT_API_MODE": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CIPHERCHAT_API_MODE": "mock",
        "EXPO_PUBLIC_CIPHERCHAT_RELEASE_EVIDENCE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CIPHERCHAT_API_MODE": "live"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
