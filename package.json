{
  "name": "cipherchat",
  "version": "1.0.0",
  "author": "Amgad Alzomi",
  "license": "UNLICENSED",
  "main": "index.ts",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "app:test": "tsx --test \"src/**/*.test.ts\"",
    "test": "npm run app:test && npm run api:test",
    "validate:ci": "npm run typecheck && npm test && npm run api:build && npm run prisma:validate && npm run api:test:integration && npm run verify:dev-build-config && npm run verify:ios-sqlcipher-readiness && npm run verify:eas-ios-cloud-build && npm run verify:os-backed-key-strategy && npm run verify:security-docs && npm run verify:signal-adapter-readiness && npm run verify:signal-integration-plan && npm run verify:file-crypto-plan && npm run verify:plaintext-lifecycle && npm run verify:abuse-controls && npm run verify:metadata-retention && npm run verify:queue-operations && npm run verify:production-config && npm run verify:startup-health && npm run verify:release-operations && npm run verify:release-evidence && npm run verify:audit-readiness && npm run verify:external-review-package && npx expo-doctor && npm audit --omit=dev --audit-level=high",
    "verify:dev-build-config": "node scripts/verify-development-build-config.mjs",
    "verify:ios-sqlcipher-readiness": "node scripts/verify-ios-sqlcipher-readiness.mjs",
    "verify:eas-ios-cloud-build": "node scripts/verify-eas-ios-cloud-build-readiness.mjs",
    "eas:ios:device-preview": "npx eas-cli@latest build --profile ios-device-preview --platform ios",
    "eas:ios:testflight": "npx eas-cli@latest build --profile ios-testflight --platform ios",
    "eas:ios:submit-latest": "npx eas-cli@latest submit --platform ios --latest",
    "verify:os-backed-key-strategy": "node scripts/verify-os-backed-key-strategy.mjs",
    "verify:security-docs": "node scripts/verify-security-docs.mjs",
    "verify:signal-adapter-readiness": "node scripts/verify-signal-adapter-readiness.mjs",
    "verify:signal-integration-plan": "node scripts/verify-signal-integration-plan.mjs",
    "verify:file-crypto-plan": "node scripts/verify-file-crypto-plan.mjs",
    "verify:plaintext-lifecycle": "node scripts/verify-plaintext-lifecycle.mjs",
    "verify:abuse-controls": "node scripts/verify-abuse-controls.mjs",
    "verify:metadata-retention": "node scripts/verify-metadata-retention.mjs",
    "verify:queue-operations": "node scripts/verify-queue-operations.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:startup-health": "node scripts/verify-startup-health.mjs",
    "verify:release-operations": "node scripts/verify-release-operations.mjs",
    "verify:release-evidence": "node scripts/verify-release-evidence.mjs",
    "collect:sqlcipher-evidence": "node scripts/collect-sqlcipher-evidence.mjs",
    "verify:audit-readiness": "node scripts/verify-audit-readiness.mjs",
    "verify:external-review-package": "node scripts/verify-external-review-package.mjs",
    "release:smoke": "node scripts/release-smoke-test.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:api",
    "typecheck:app": "tsc --noEmit",
    "typecheck:api": "npm run typecheck --workspace @cipherchat/api",
    "api:dev": "npm run dev --workspace @cipherchat/api",
    "api:worker": "npm run worker --workspace @cipherchat/api",
    "api:build": "npm run build --workspace @cipherchat/api",
    "api:test": "npm run test --workspace @cipherchat/api",
    "api:test:integration": "npm run test:integration --workspace @cipherchat/api",
    "prisma:generate": "npm run prisma:generate --workspace @cipherchat/api",
    "prisma:validate": "npm run prisma:validate --workspace @cipherchat/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @cipherchat/api"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@op-engineering/op-sqlite": "^15.2.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "expo": "~55.0.19",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.30",
    "expo-font": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "private": true
}
