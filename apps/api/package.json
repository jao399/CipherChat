{
  "name": "@cipherchat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "prisma:generate": "node scripts/with-prisma-env.mjs generate",
    "prisma:validate": "node scripts/with-prisma-env.mjs validate",
    "prisma:migrate:deploy": "node scripts/with-prisma-env.mjs migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.76.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
